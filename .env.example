# Скопируйте файл в .env и заполните значения

# Токен бота от @BotFather
BOT_TOKEN=

# Публичный HTTPS-адрес, где открыт этот сервер (Telegram открывает Mini App только по HTTPS)
# Например: https://nails.example.com или адрес туннеля cloudflared/ngrok
WEBAPP_URL=https://nails.example.com

# Telegram ID мастера (через запятую, если мастеров несколько). Узнать ID — команда /id в боте
ADMIN_IDS=123456789

# Куда присылать уведомления о новых записях. Можно ID группы (например, -1001234567890).
# Если не указан — уведомления получают все ADMIN_IDS
MASTER_CHAT_ID=

# Часовой пояс мастера: от него считается расписание
TIMEZONE=Europe/Moscow

# Название мастера или студии — в заголовке страницы записи
SALON_NAME="Запись к мастеру"
CURRENCY=₽

# Сколько будущих записей может быть одновременно у одного клиента
MAX_ACTIVE_BOOKINGS=3

# Файл базы SQLite (относительно папки проекта)
DATABASE_PATH=data/nails.db

HOST=0.0.0.0
PORT=8080

# polling — бот сам опрашивает Telegram (проще всего)
# webhook — Telegram присылает обновления на WEBAPP_URL/tg/webhook
# off — бот не принимает сообщения, только отправляет уведомления
BOT_MODE=polling
# Секрет для проверки запросов webhook (латиница, цифры, _ и -)
WEBHOOK_SECRET=

# Только для разработки: открывает API без Telegram, любой посетитель становится админом.
# НИКОГДА не включайте на боевом сервере
DEV_MODE=0
